# ---------- Core ----------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Public address of the portal (used in the link inside messages)
PORTAL_BASE_URL=http://localhost:8000
# Set true when served over HTTPS
SECURE_COOKIES=false
# Key for the upload API (X-API-Key header). Leave empty to disable the API.
API_KEY=
TEAM_NAME=Claims Support Team
TEAM_CONTACT=please contact our claims team
DISPLAY_TZ=Asia/Kolkata

# ---------- AI for reading letters and matching (optional but recommended) ----------
# anthropic | openai | gemini | none  (none = built-in rules engine)
LLM_PROVIDER=none
# Leave empty for the default model of the provider
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Strip Aadhaar/PAN/account/phone/email numbers before text is sent to the AI provider
REDACT_IDS_FOR_LLM=true

# ---------- WhatsApp ----------
# twilio | meta | console  (console = record in history, do not send)
WHATSAPP_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sandbox number by default
TWILIO_WHATSAPP_FROM=+14155238886
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v21.0
# Approved template with one body parameter, needed for business-initiated messages on Meta
META_TEMPLATE_NAME=
META_TEMPLATE_LANG=en

# ---------- Email ----------
# smtp | console
EMAIL_PROVIDER=console
# Gmail: smtp.gmail.com, port 587, your address as SMTP_USER and a Google "app password"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false
EMAIL_FROM=

# ---------- Testing / judging ----------
# If set, every message goes to this number / address instead of the patient's own
TEST_RECIPIENT_PHONE=
TEST_RECIPIENT_EMAIL=
# Send a "nothing needed" message when every point is already in the locker
NOTIFY_WHEN_NOTHING_NEEDED=true
DEFAULT_COUNTRY_CODE=91

# ---------- Seed logins (used by scripts/seed.py) ----------
SEED_ADMIN_PASSWORD=admin12345
SEED_STAFF_PASSWORD=staff12345
SEED_PATIENT_PASSWORD=patient12345
